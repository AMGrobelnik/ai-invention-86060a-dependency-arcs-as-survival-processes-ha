\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Primary Finding: No Significant Register Effect at Gold-Label Quality}{7}{subsection.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Non-parametric survival curves (1 minus cumulative hazard) for gold-labeled spoken vs. written dependency arcs across English, French, and Slovenian. Curves show the probability that an arc of length \textgreater d has not yet closed by distance d. Spoken (orange) and written (blue) curves largely overlap within each language, indicating no systematic register difference in arc-length distributions at gold-label quality.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:fig1}{{1}{7}{Non-parametric survival curves (1 minus cumulative hazard) for gold-labeled spoken vs. written dependency arcs across English, French, and Slovenian. Curves show the probability that an arc of length \textgreater d has not yet closed by distance d. Spoken (orange) and written (blue) curves largely overlap within each language, indicating no systematic register difference in arc-length distributions at gold-label quality}{figure.1}{}}
\citation{Gerdes2026}
